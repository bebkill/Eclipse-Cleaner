# Media: pipeline inputs and outputs stay out of version control.
# (The small demo GIFs under docs/assets/ ARE versioned.)
data/

# The viewer's per-video work folder: cache, decisions, thumbnails, render
# and PNG export all live in it (see viewer.work_folder).
*-eclipse/

# Analysis cache (regenerated by `analyze`)
analysis.json
*-analysis.json

# Manual review decisions (personal to each video)
decisions.json
*-decisions.json
*.precedent

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Construction de l'executable (PyInstaller) et des paquets
build/
dist/

# Review thumbnails (regenerated by the viewer)
.vignettes/
*-vignettes/

# Local backups
*.bak
